{
  "kind": "collectionType",
  "collectionName": "press_releases",
  "info": {
    "singularName": "press-release",
    "pluralName": "press-releases",
    "displayName": "Press Release"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "Title"
    },
    "Headline": {
      "type": "string",
      "maxLength": 100,
      "required": true
    },
    "Subheadline": {
      "type": "string"
    },
    "dateline_city": {
      "type": "string",
      "default": "Arlington"
    },
    "dateline_state": {
      "type": "string",
      "default": "VA"
    },
    "for_immediate_release": {
      "type": "boolean",
      "default": true
    },
    "embargo_until": {
      "type": "datetime",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "for_immediate_release"
            },
            false
          ]
        }
      }
    },
    "public_release_at": {
      "type": "datetime",
      "required": true
    },
    "lede": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "body": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "call_to_action": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "boilerplate": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "pull_quote": {
      "type": "component",
      "component": "shared.quote",
      "repeatable": true
    },
    "media_contact": {
      "type": "component",
      "component": "shared.media-contact",
      "repeatable": true
    }
  }
}
